<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.szsz-hub</groupId>
    <artifactId>cyberark-vaultops</artifactId>
    <version>1.0</version>

    <name>CyberArk / Idira VaultOps</name>
    <description>Open-source administrator tool for managing CyberArk / Idira (Palo Alto Networks)
        Self-Hosted PAM configurations and policies.</description>
    <url>https://github.com/SzSz-hub/CyberArk-VaultOps</url>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.10</javafx.version>
        <!-- Default classifier; overridden per-OS by the profiles below so the build is portable. -->
        <javafx.platform>win</javafx.platform>
        <!-- jpackage output type. "app-image" works on every OS without extra installer tooling; override
             from the command line (e.g. -Djpackage.type=msi / dmg / deb) to build a native installer. -->
        <jpackage.type>app-image</jpackage.type>
        <!-- jpackage icon. The default is the multi-resolution Windows .ico; the icon-* profiles below
             switch it to a PNG on Linux/macOS. The icon follows the HOST OS (jpackage only builds for the
             machine it runs on), so it is deliberately decoupled from the toggleable platform-* profiles. -->
        <jpackage.icon>${project.build.directory}/app-icon.ico</jpackage.icon>
    </properties>

    <profiles>
        <!-- platform-* select only the JavaFX native classifier; they may be force-activated to
             cross-bundle the fat jar for another OS and intentionally do NOT touch the jpackage icon. -->
        <profile>
            <id>platform-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation>
                <os><family>unix</family><name>Linux</name></os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>platform-mac-x86</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>platform-mac-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties>
                <javafx.platform>mac-aarch64</javafx.platform>
            </properties>
        </profile>

        <!-- icon-* are auto-activated by the host OS only (never meant to be toggled): jpackage on
             Windows requires .ico, while the Linux/macOS backends take a PNG. Keeping these separate from
             platform-* means a force-activated platform profile can never feed a PNG to Windows jpackage. -->
        <profile>
            <id>icon-linux</id>
            <activation>
                <os><family>unix</family><name>Linux</name></os>
            </activation>
            <properties>
                <jpackage.icon>${project.build.directory}/app-icon-256.png</jpackage.icon>
            </properties>
        </profile>
        <profile>
            <id>icon-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.build.directory}/app-icon.icns</jpackage.icon>
            </properties>
        </profile>

        <!--
          Native packaging profile. Generates the multi-resolution Windows icon from AppIcon and
          runs jpackage to produce a native app-image whose window, taskbar AND executable file
          icon all use it (stage.getIcons() alone cannot set the taskbar/exe icon on Windows).

          Usage:  mvn -P native-package clean package
          Output: target/dist/CyberArk VaultOps/
        -->
        <profile>
            <id>native-package</id>
            <build>
                <plugins>
                    <!-- 1) Prepare a clean, jar-only input dir and wipe previous output. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/dist"/>
                                        <delete dir="${project.build.directory}/jpackage-input"/>
                                        <mkdir dir="${project.build.directory}/jpackage-input"/>
                                        <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                                              todir="${project.build.directory}/jpackage-input"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <!-- 2) Render app-icon.ico (+ PNGs) into the target directory. -->
                            <execution>
                                <id>generate-icon</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>IconExporter</mainClass>
                                    <arguments>
                                        <argument>${project.build.directory}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 3) Build a native app-image with jpackage, embedding the icon. -->
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${jpackage.type}</argument>
                                        <argument>--name</argument>
                                        <argument>CyberArk VaultOps</argument>
                                        <argument>--app-version</argument>
                                        <argument>1.0</argument>
                                        <argument>--vendor</argument>
                                        <argument>CyberArk VaultOps</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.artifactId}-${project.version}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>Launcher</argument>
                                        <argument>--icon</argument>
                                        <argument>${jpackage.icon}</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>build-info.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>build-info.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>Launcher</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/substrate/config/*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Launcher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
